# Copy this file to .env (which is git-ignored — see .gitignore) and fill
# in your own local credentials. Never commit a real .env file.
#
# If DATABASE_URL is left unset (no .env, no OS env var), the pipeline
# falls back to a local SQLite file at data/interim/pharma_di.db — see
# src/pharma_di/persist/db.py.

DATABASE_URL=mysql+pymysql://pharma_di_app:YourPasswordHere@localhost/pharma_di
